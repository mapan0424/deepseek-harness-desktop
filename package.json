{
  "name": "harness-desktop-macos",
  "private": true,
  "version": "0.1.4",
  "description": "Unofficial Tauri desktop client for DeepSeek Harness",
  "license": "MIT",
  "repository": "https://github.com/mapan0424/deepseek-harness-desktop",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "prepare:runtime:intel": "node scripts/prepare-runtime-intel.mjs",
    "prepare:licenses": "node scripts/prepare-rust-licenses.mjs",
    "test:runtime:compat": "node scripts/test-runtime-compat.mjs",
    "verify:macos:arm": "node scripts/verify-macos-bundle.mjs 'src-tauri/target/release/bundle/macos/DeepSeek Harness.app' arm64",
    "verify:macos:intel": "node scripts/verify-macos-bundle.mjs 'src-tauri/target/x86_64-apple-darwin/release/bundle/macos/DeepSeek Harness.app' x86_64",
    "build:macos": "pnpm prepare:runtime && pnpm prepare:licenses && pnpm tauri build --no-sign && pnpm verify:macos:arm",
    "build:macos:intel": "node scripts/build-macos-intel.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
