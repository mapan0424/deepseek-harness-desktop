{
  "name": "@anarkhgatsby/deepseek-harness-channel-imessage",
  "version": "0.1.10",
  "description": "Channel plugin for DeepSeek Harness: local-only iMessage transport through Messages.app and chat.db. Thin facade on @anarkhgatsby/deepseek-harness-core.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mapan0424/deepseek-harness-plugins.git",
    "directory": "packages/harness-channel-imessage"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/config.mjs",
    "lib/adapters/local.mjs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "license": "MIT",
  "os": [
    "darwin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anarkhgatsby/deepseek-harness-core": "0.1.9"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-typert-protocol": "0.1.5-rc.1 || 0.1.5-rc.2 || 0.1.6-alpha.2 || 0.1.7-rc.2 || ^0.1.7-0 || >=0.1.7",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1 || 0.1.5-rc.2 || 0.1.6-alpha.2 || 0.1.7-rc.2 || ^0.1.7-0 || >=0.1.7",
    "@deepseek-ai/schemastery": ">=3.18.0"
  }
}
