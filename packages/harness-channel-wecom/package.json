{
  "name": "@anarkhgatsby/deepseek-harness-channel-wecom",
  "version": "0.1.8",
  "description": "Channel plugin for DeepSeek Harness: 企业微信 / WeCom (Intelligent Robot Long Connection) behind one message bus. Thin facade on @anarkhgatsby/deepseek-harness-core.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mapan0424/deepseek-harness-plugins.git",
    "directory": "packages/harness-channel-wecom"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/config.mjs",
    "lib/adapters/wecom.mjs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dependencies": {
    "@anarkhgatsby/deepseek-harness-core": "0.1.8"
  },
  "optionalDependencies": {
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-typert-protocol": "0.1.5-rc.1 || 0.1.5-rc.2 || 0.1.6-alpha.2 || 0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1 || 0.1.5-rc.2 || 0.1.6-alpha.2 || 0.1.7-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.0"
  }
}
