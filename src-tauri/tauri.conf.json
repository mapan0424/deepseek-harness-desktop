{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness",
  "version": "0.1.3",
  "identifier": "io.github.mapan0424.harness-desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DeepSeek Harness — 非官方客户端",
        "width": 1240,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/dsh-runtime/",
      "legal/APP_LICENSE",
      "legal/DEEPSEEK_HARNESS_LICENSE",
      "legal/RUST_THIRD_PARTY_LICENSES.txt",
      "legal/THIRD_PARTY_NOTICES.md",
      "legal/UNOFFICIAL_NOTICE.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
