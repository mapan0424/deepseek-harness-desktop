{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness",
  "version": "0.3.2",
  "identifier": "io.github.mapan0424.harness-desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "splash",
        "title": "DeepSeek Harness — 非官方客户端",
        "width": 560,
        "height": 420,
        "resizable": false,
        "center": true,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/dsh-runtime/",
      "legal/APP_LICENSE",
      "legal/DEEPSEEK_HARNESS_LICENSE",
      "legal/RUST_THIRD_PARTY_LICENSES.txt",
      "legal/THIRD_PARTY_NOTICES.md",
      "legal/UNOFFICIAL_NOTICE.txt"
    ],
    "macOS": {
      "minimumSystemVersion": "12.7.6"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon-whale-macos.icns",
      "icons/icon.ico",
      "icons/Assets.car"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGODU0NkJGRTUyMTg1RApSV1JkR0ZMK2ExVDRBdFVpRnFPbHJsNXFLOElLekFYRm9nOHd3TVNSeHlBRTZqVmc4TEFmVkJVSAo=",
      "endpoints": [
        "https://github.com/mapan0424/deepseek-harness-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
